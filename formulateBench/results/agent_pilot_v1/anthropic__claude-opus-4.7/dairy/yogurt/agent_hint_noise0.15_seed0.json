   print(f\"Iter {d['iteration']}: score={d['target_dissimilarity']:.4f} | {ings}\")\n", "\nimport json\nwith open('evaluations.json') as f:\n    data = json.load(f)\n\n# Group by recipe signature\nfrom collections import defaultdict\ngroups = defaultdict(list)\nfor d in data:\n    sig = tuple(sorted((r['ingredient'], round(r['fraction'],3)) for r in d['recipe']))\n    groups[sig].append(d['target_dissimilarity'])\n\nfor sig, scores in groups.items():\n    if len(scores) > 1:\n        print(f\"Replicated {len(scores)}x: mean={sum(scores)/len(scores):.3f}, scores={scores}\")\n        print(f\"  {dict(sig)}\")\n\n# Compute averages for each unique recipe\nprint(\"\\nAll recipes sorted by mean score:\")\nsigs_mean = [(sig, sum(s)/len(s), len(s), min(s)) for sig,s in groups.items()]\nsigs_mean.sort(key=lambda x: x[1])\nfor sig, mean, n, mn in sigs_mean[:8]:\n    print(f\"  mean={mean:.3f} n={n} min={mn:.3f}\")\n    print(f\"    {dict(sig)}\")\n"]}
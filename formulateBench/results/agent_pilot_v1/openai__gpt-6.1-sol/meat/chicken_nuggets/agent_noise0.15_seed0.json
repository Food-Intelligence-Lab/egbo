soy protein isolate' in r else 0))\nX=np.array(X); y=np.array(y); w=np.linalg.lstsq(X,y,rcond=None)[0]; print(names,base); print('coef',w,'resid',y-X@w)\ndef pred(x):\n z=(x-base)/base\n return w[0]+z[:8]@w[1:9]+w[-1]*sum(z*z)\nres=minimize(pred,base,bounds=[(b*.7,b*1.3) for b in base],constraints={'type':'eq','fun':lambda x:x.sum()-1},method='SLSQP',options={'ftol':1e-12}); print(res.x,res.fun)\n"]}
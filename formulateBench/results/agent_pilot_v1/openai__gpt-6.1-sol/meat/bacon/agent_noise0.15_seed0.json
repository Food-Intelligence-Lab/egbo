normal(0,.003,9),bounds=[(max(0,v-.04),v+.04) for v in best],constraints={'type':'eq','fun':lambda x:x.sum()-1}) for _ in range(10)],key=lambda r:r.fun)\nprint(res.fun,list(zip(names,res.x)));np.savez('modeldata.npz',X=X,y=y)\n", "import numpy as np,json\nfrom scipy.optimize import least_squares\nD=json.load(open('evaluations.json')); ns=[r['ingredient'] for r in D[0]['recipe']];X=np.array([[next((r['fraction'] for r in d['recipe'] if r['ingredient']==n),0) for n in ns] for d in D]);y=np.array([d['target_dissimilarity'] for d in D]); b=X[y.argmin()];Z=(X-b)/np.array([.04,.04,.04,.01,.04,.03,.005,.005,.005]);\n# ridge quadratic separate centered features\nfrom sklearn.linear_model import Ridge\nfor alpha in [.01,.1,1]:\n F=np.c_[Z,Z**2]; reg=Ridge(alpha=alpha).fit(F,y); print(alpha,reg.intercept_,reg.coef_[:9],reg.coef_[9:]);\n"]}